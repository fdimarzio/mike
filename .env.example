# ─────────────────────────────────────────────────────────────────────────────
# .env.local  —  copy this file to .env.local and fill in your values
#
# VITE_ prefix  → exposed to the browser (safe for public consumer key)
# No prefix     → server-side only, never sent to the browser
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (existing)
VITE_SUPABASE_URL=https://ufagnokxmetushstgrip.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_6j809j_-BCE2A26Yhq_1-Q_VuaRxSeI

# ── E*TRADE Sandbox ───────────────────────────────────────────────────────────
# Consumer key from https://developer.etrade.com  (sandbox app)
VITE_ETRADE_CONSUMER_KEY=013da7eb8323b38f39481480f283680a

# Consumer SECRET — never prefix with VITE_ (stays server-side in Vite proxy)
ETRADE_CONSUMER_SECRET=c45454cd8dda76bc0d68a268947aa780ea9b6fae48d27e5a52661242a71bd29

# Access token + secret — obtained once via the OAuth flow below
# After you have them, paste them here and they'll be reused automatically.
ETRADE_ACCESS_TOKEN=your_access_token
ETRADE_ACCESS_TOKEN_SECRET=your_access_token_secret

# ─────────────────────────────────────────────────────────────────────────────
# HOW TO GET YOUR ACCESS TOKEN (one-time setup, sandbox)
#
# 1. Request token:
#    GET https://apisb.etrade.com/oauth/request_token
#    (signed with your consumer key/secret — use Postman with OAuth 1.0 helper)
#
# 2. Authorize:
#    Open in browser:
#    https://us.etrade.com/e/t/etws/authorize?key=YOUR_CONSUMER_KEY&token=REQUEST_TOKEN
#    Log in with your E*TRADE sandbox account and approve.
#    You'll be redirected to your callback URL (or shown a verifier code).
#
# 3. Exchange for access token:
#    GET https://apisb.etrade.com/oauth/access_token
#    Include oauth_token (request token) + oauth_verifier in the OAuth header.
#
# 4. Copy the oauth_token and oauth_token_secret from the response into
#    ETRADE_ACCESS_TOKEN and ETRADE_ACCESS_TOKEN_SECRET above.
#
# Access tokens in the sandbox do not expire.
# ─────────────────────────────────────────────────────────────────────────────
